<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" width="120" height="120">
  <defs>
    <linearGradient id="needle-metal" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffffff"/>
      <stop offset="50%" stop-color="#cbd5e1"/>
      <stop offset="100%" stop-color="#64748b"/>
    </linearGradient>
    <linearGradient id="barrel-glass" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="rgba(255,255,255,0.95)"/>
      <stop offset="70%" stop-color="rgba(241,245,249,0.85)"/>
      <stop offset="100%" stop-color="rgba(203,213,225,0.7)"/>
    </linearGradient>
    <linearGradient id="anesthetic-liquid" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.9"/>
      <stop offset="100%" stop-color="#0284c7" stop-opacity="0.4"/>
    </linearGradient>
  </defs>

  <g filter="drop-shadow(0px 2px 4px rgba(2, 132, 199, 0.4))">
    <!-- 1. Needle Shaft (Needle tip exact origin at 0,0) -->
    <line x1="0" y1="0" x2="22" y2="22" stroke="url(#needle-metal)" stroke-width="2.5" stroke-linecap="round"/>
    
    <!-- 2. Hub Adapter (Plastic lock) -->
    <polygon points="19,16 27,24 23,28 15,20" fill="#94a3b8" stroke="#475569" stroke-width="0.8"/>
    <polygon points="23,20 31,28 27,32 19,24" fill="#0284c7" opacity="0.85"/>

    <!-- 3. Syringe Barrel (45-degree angle rotation) -->
    <g transform="rotate(45 0 0)">
      <!-- Main Barrel Outer Cylinder -->
      <rect x="25" y="-7" width="52" height="14" rx="2" fill="url(#barrel-glass)" stroke="#475569" stroke-width="1.2"/>
      
      <!-- Liquid Level Inside Barrel -->
      <rect x="26" y="-5.5" width="34" height="11" fill="url(#anesthetic-liquid)"/>

      <!-- Graduation Scale Lines -->
      <line x1="32" y1="-6" x2="32" y2="-1" stroke="#1e293b" stroke-width="0.8"/>
      <line x1="38" y1="-6" x2="38" y2="-3" stroke="#1e293b" stroke-width="0.8"/>
      <line x1="44" y1="-6" x2="44" y2="-1" stroke="#1e293b" stroke-width="0.8"/>
      <line x1="50" y1="-6" x2="50" y2="-3" stroke="#1e293b" stroke-width="0.8"/>
      <line x1="56" y1="-6" x2="56" y2="-1" stroke="#1e293b" stroke-width="0.8"/>
      <line x1="62" y1="-6" x2="62" y2="-3" stroke="#1e293b" stroke-width="0.8"/>

      <!-- Dosage Numbers -->
      <text x="31" y="4.5" font-size="3.5" font-weight="bold" fill="#0f172a" font-family="sans-serif">1</text>
      <text x="43" y="4.5" font-size="3.5" font-weight="bold" fill="#0f172a" font-family="sans-serif">2</text>
      <text x="55" y="4.5" font-size="3.5" font-weight="bold" fill="#0f172a" font-family="sans-serif">3ml</text>

      <!-- Black Rubber Gasket Stopper -->
      <rect x="60" y="-6" width="6" height="12" rx="1" fill="#0f172a"/>

      <!-- Finger Grip Flange -->
      <rect x="77" y="-12" width="4" height="24" rx="1.5" fill="#f8fafc" stroke="#475569" stroke-width="1.2"/>

      <!-- Plunger Shaft -->
      <rect x="66" y="-2.5" width="30" height="5" fill="#e2e8f0" stroke="#64748b" stroke-width="0.8"/>

      <!-- Plunger Push Handle Button -->
      <rect x="96" y="-9" width="4" height="18" rx="1" fill="#0ea5e9" stroke="#0284c7" stroke-width="1"/>
    </g>
  </g>
</svg>
